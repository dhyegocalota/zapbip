{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zapbip-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": { "bindings": [{ "name": "ACCOUNT_INBOX", "class_name": "AccountInbox" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountInbox"] }],
  "d1_databases": [
    {
      "binding": "CONNECTIONS",
      "database_name": "zapbip-production",
      "database_id": "2147fd23-d09d-4609-9c5e-5751453794df",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "zapbip-media-production" }],
  "analytics_engine_datasets": [{ "binding": "WAKE_METRICS", "dataset": "zapbip_wake_production" }],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "routes": [
    { "pattern": "mcp.zapbip.com", "custom_domain": true },
    { "pattern": "backoffice.zapbip.com", "custom_domain": true },
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_ORIGIN": "https://mcp.zapbip.com",
    "BACKOFFICE_ORIGIN": "https://backoffice.zapbip.com",
    "WAITLIST_ENABLED": "true",
    "WHATSAPP_GRAPH_BASE_URL": "https://graph.facebook.com",
  },
  "ratelimits": [
    { "name": "OWNER_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "OUTBOUND_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "ACCOUNT_OUTBOUND_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
    { "name": "INSTALL_PAGE_LIMITER", "namespace_id": "1004", "simple": { "limit": 30, "period": 60 } },
    { "name": "BACKOFFICE_RATE_LIMITER", "namespace_id": "1005", "simple": { "limit": 5, "period": 60 } },
  ],
  "triggers": { "crons": ["*/30 * * * *"] },
  "env": {
    "development": {
      "name": "zapbip-api-development",
      "main": "src/index.dev.ts",
      "durable_objects": { "bindings": [{ "name": "ACCOUNT_INBOX", "class_name": "AccountInbox" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountInbox"] }],
      "d1_databases": [
        {
          "binding": "CONNECTIONS",
          "database_name": "zapbip-development",
          "database_id": "zapbip-connections-local",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "zapbip-media-development" }],
      "analytics_engine_datasets": [{ "binding": "WAKE_METRICS", "dataset": "zapbip_wake_development" }],
      "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
      "vars": {
        "ENVIRONMENT": "development",
        "PUBLIC_ORIGIN": "http://localhost:8787",
        "BACKOFFICE_ORIGIN": "http://backoffice.localhost:8787",
        "WAITLIST_ENABLED": "false",
        "WHATSAPP_GRAPH_BASE_URL": "http://127.0.0.1:4011",
        "WHATSAPP_MEDIA_DOWNLOAD_ORIGIN": "http://127.0.0.1:4011",
      },
      "ratelimits": [
        { "name": "OWNER_RATE_LIMITER", "namespace_id": "3001", "simple": { "limit": 20, "period": 60 } },
        { "name": "OUTBOUND_RATE_LIMITER", "namespace_id": "3002", "simple": { "limit": 30, "period": 60 } },
        { "name": "ACCOUNT_OUTBOUND_RATE_LIMITER", "namespace_id": "3003", "simple": { "limit": 120, "period": 60 } },
        { "name": "INSTALL_PAGE_LIMITER", "namespace_id": "3004", "simple": { "limit": 30, "period": 60 } },
        { "name": "BACKOFFICE_RATE_LIMITER", "namespace_id": "3005", "simple": { "limit": 5, "period": 60 } },
      ],
      "triggers": { "crons": ["*/30 * * * *"] },
    },
    "staging": {
      "name": "zapbip-api-staging",
      "main": "src/index.ts",
      "durable_objects": { "bindings": [{ "name": "ACCOUNT_INBOX", "class_name": "AccountInbox" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountInbox"] }],
      "d1_databases": [
        {
          "binding": "CONNECTIONS",
          "database_name": "zapbip-staging",
          "database_id": "7f784389-c79d-46f0-b9ea-2a3eab8aa2ff",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "zapbip-media-staging" }],
      "analytics_engine_datasets": [{ "binding": "WAKE_METRICS", "dataset": "zapbip_wake_staging" }],
      "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
      "routes": [
        { "pattern": "mcp-staging.zapbip.com", "custom_domain": true },
        { "pattern": "backoffice-staging.zapbip.com", "custom_domain": true },
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "PUBLIC_ORIGIN": "https://mcp-staging.zapbip.com",
        "BACKOFFICE_ORIGIN": "https://backoffice-staging.zapbip.com",
        "WAITLIST_ENABLED": "false",
        "WHATSAPP_GRAPH_BASE_URL": "https://graph.facebook.com",
      },
      "ratelimits": [
        { "name": "OWNER_RATE_LIMITER", "namespace_id": "2001", "simple": { "limit": 20, "period": 60 } },
        { "name": "OUTBOUND_RATE_LIMITER", "namespace_id": "2002", "simple": { "limit": 30, "period": 60 } },
        { "name": "ACCOUNT_OUTBOUND_RATE_LIMITER", "namespace_id": "2003", "simple": { "limit": 120, "period": 60 } },
        { "name": "INSTALL_PAGE_LIMITER", "namespace_id": "2004", "simple": { "limit": 30, "period": 60 } },
        { "name": "BACKOFFICE_RATE_LIMITER", "namespace_id": "2005", "simple": { "limit": 5, "period": 60 } },
      ],
      "triggers": { "crons": ["*/30 * * * *"] },
    },
  },
}
