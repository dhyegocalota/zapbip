    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261106.1",
    "@types/node": "24.19.2",
    "@vitest/runner": "4.1.12",
    "@vitest/snapshot": "4.1.12",
    "drizzle-kit": "0.31.11",
    "vitest": "4.1.12",
    "wrangler": "4.158.0"
  }
