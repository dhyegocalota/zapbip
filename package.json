{
  "name": "zapbip",
  "private": true,
  "packageManager": "pnpm@8.15.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "security:audit": "pnpm audit --prod --audit-level=high",
    "test:unit": "pnpm -r test:unit && pnpm test:hooks && pnpm test:verify",
    "test:hooks": "bash .agents/hooks/hooks.test.sh",
    "test:verify": "bash scripts/verify.test.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:staging": "node --env-file=.env --import tsx apps/api/scripts/deploy.ts --environment staging",
    "deploy:production": "node --env-file=.env --import tsx apps/api/scripts/deploy.ts --environment production",
    "migrate:development": "pnpm --filter @zapbip/api exec wrangler d1 migrations apply zapbip-development --env development --local",
    "migrate:staging": "pnpm --filter @zapbip/api exec wrangler d1 migrations apply zapbip-staging --env staging --remote",
    "migrate:production": "pnpm --filter @zapbip/api exec wrangler d1 migrations apply zapbip-production --remote",
    "smoke:development": "node --env-file=.env --import tsx apps/api/scripts/smoke.ts --environment development",
    "smoke:staging": "node --env-file=.env --import tsx apps/api/scripts/smoke.ts --environment staging",
    "smoke:production": "node --env-file=.env --import tsx apps/api/scripts/smoke.ts --environment production",
    "docs:preflight": "node --env-file=.env --import tsx apps/api/scripts/docs-preflight.ts",
    "hermes-wheel:build": "node --import tsx scripts/hermes-wheel/build.ts",
    "verify": "bash scripts/verify.sh",
    "test:e2e:clients": "ZAPBIP_E2E_CLIENTS=1 pnpm --filter @zapbip/api exec vitest run --config vitest.e2e.config.mts test/e2e/hermes-openclaw.e2e.test.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
