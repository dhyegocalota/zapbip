{
  "name": "zapbip",
  "private": true,
  "packageManager": "pnpm@8.15.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "security:audit": "pnpm audit --prod --audit-level=high",
    "test:unit": "pnpm -r test:unit && pnpm test:hooks && pnpm test:verify",
    "test:hooks": "bash .agents/hooks/hooks.test.sh",
    "test:verify": "bash scripts/verify.test.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "bash scripts/verify.sh",
    "test:e2e:clients": "ZAPBIP_E2E_CLIENTS=1 pnpm --filter @zapbip/api exec vitest run --config vitest.e2e.config.mts test/e2e/hermes-openclaw.e2e.test.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "openclaw"
    ]
  }
}
